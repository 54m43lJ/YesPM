# OpenAI API 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 可选：Azure OpenAI 配置
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=

# 工作流配置
MAX_ITERATIONS=3          # 审核-修改最大迭代次数
DRAFT_MAX_ROUNDS=50       # 阶段内逐轮问答最大轮次上限（超出后审核放行）
TEMPERATURE=0.3           # LLM 温度参数（PRD 撰写建议低温度）
