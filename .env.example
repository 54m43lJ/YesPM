# OpenAI 兼容 API 配置（支持 DeepSeek / OpenAI / 本地网关等）
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 工作流配置
YESPM_TEMPERATURE=0.3            # LLM 温度参数（PRD 撰写建议低温度）
YESPM_UNIT_MAX_TURNS=5           # 单个访谈单元最大对话轮数（超限强制评审）
YESPM_DOC_REVIEW_MAX_ITERS=3     # 全文档审核最大往返轮数（超限强制进入渲染并附未决清单）
YESPM_POLISH_MAX_ROUNDS=2        # 润色生成器-评估器最大修订轮数（仍不通过则丢弃提案）

# 调试配置
# YESPM_MOCK=1                    # 使用确定性 mock LLM（无需 API Key，用于测试/演示）
# YESPM_SESSION_DIR=~/.yespm      # 会话与检查点存储目录
# YESPM_TEMPLATE=                 # 自定义模板 YAML 路径（默认使用内置 PRD 模板）
